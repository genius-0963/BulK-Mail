# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in your credentials
# ==============================================================================

# Server & Application
NODE_ENV=development
PORT=3000
BASE_PATH=/

# PostgreSQL Database (Required for persistent campaigns & delivery logs)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bulk_outreach

# Clerk Authentication (Required for user authentication & access control)
# Get your keys at https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Google Gmail API / OAuth2 Configuration
# Get your credentials at https://console.cloud.google.com/apis/credentials
# Ensure Gmail API is enabled with scopes:
# - https://www.googleapis.com/auth/gmail.send
# - https://www.googleapis.com/auth/gmail.readonly
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# Optional: Direct Access Token (for local testing/temporary usage)
# GOOGLE_ACCESS_TOKEN=ya29...
